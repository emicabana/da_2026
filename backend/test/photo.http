@authorizationToken = 

### GET - Listar todas las fotos (público)
GET http://localhost:3000/api/photos

###

### GET - Ver una foto por id
GET http://localhost:3000/api/photos/{{photoId}}

###

@photoId = 

### POST - Subir imagen (solo admin o fotógrafo)
### Reemplazá ./sample.jpg por la ruta de una imagen local válida.
POST http://localhost:3000/api/photos/upload
Authorization: Bearer {{authorizationToken}}
Content-Type: multipart/form-data; boundary=RevelaBoundary

--RevelaBoundary
Content-Disposition: form-data; name="title"

Egresados 2024 - Grupo 1
--RevelaBoundary
Content-Disposition: form-data; name="description"

Foto grupal del baile de egresados
--RevelaBoundary
Content-Disposition: form-data; name="price"

1500
--RevelaBoundary
Content-Disposition: form-data; name="image"; filename="sample.jpg"
Content-Type: image/jpeg

< ./sample.jpg
--RevelaBoundary--
###

### PATCH - Modificar foto (solo admin)
PATCH http://localhost:3000/api/photos/{{photoId}}
Authorization: Bearer {{authorizationToken}}
Content-Type: application/json

{
    "price": 2000
}

###

### DELETE - Eliminar foto (solo admin)
DELETE http://localhost:3000/api/photos/{{photoId}}
Authorization: Bearer {{authorizationToken}}